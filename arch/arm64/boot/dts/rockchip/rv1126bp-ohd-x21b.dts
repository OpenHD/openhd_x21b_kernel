/dts-v1/;
#include "rv1126bp.dtsi"

/ {
	model = "OpenHD X21B";
	compatible = "openhd,x21b", "rockchip,rv1126b";

	chosen {
		bootargs = "earlycon=uart8250,mmio32,0x20810000 console=ttyFIQ0 root=/dev/mtdblock4 coherent_pool=32K";
	};

	// Input is 7-23V but linux dont allow variable voltage fixed rg so fix at 12v
	vcc_vbat: vcc-vbat {
		compatible = "regulator-fixed";
		regulator-name = "vcc12v_dcin";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
	};

	vcc5v0_sys: vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc_vbat>;
	};

	vcc3v3_sys: vcc33sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vdd_npu: vdd-npu {
		compatible = "regulator-fixed";
		regulator-name = "vdd_npu";
		regulator-min-microvolt = <1050000>;
		regulator-max-microvolt = <1050000>;
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&vcc5v0_sys>;
	};

	vdd_arm: vdd-arm {
		compatible = "regulator-fixed";
		regulator-name = "vdd_arm";
		regulator-min-microvolt = <1050000>;
		regulator-max-microvolt = <1050000>;
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc_1v8: vcc-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc5v0_sys>;
	};

	// SD regulators are fake, as sdmmc needs to claim them, and have 2 separate regs, on the board there is single 3v3 fixed regulator
	vcc3v3_sd: vcc3v3-sd {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_sd";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc3v3_sys>;
		regulator-state-mem {
			regulator-off-in-suspend;
			regulator-suspend-microvolt = <3300000>;
		};
	};

	vccio_sd: vccio-sd {
		compatible = "regulator-fixed";
		regulator-name = "vccio_sd";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc3v3_sys>;
		regulator-state-mem {
			regulator-off-in-suspend;
			regulator-suspend-microvolt = <3300000>;
		};
	};


};

&cpu0 {
	cpu-supply = <&vdd_arm>;
};

&csi2_dphy0 {
	status = "okay";

	port@0 {
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <0>;

		csi_dphy_input1: endpoint@1 {
			reg = <1>;
			remote-endpoint = <&runcam_micro_v1_out>;
			data-lanes = <1 2 3 4>;
		};

		csi_dphy_input2: endpoint@2 {
			reg = <2>;
			remote-endpoint = <&runcam_micro_v2_out>;
			data-lanes = <1 2 3 4>;
		};

		csi_dphy_input3: endpoint@3 {
			reg = <3>;
			remote-endpoint = <&runcam_nano_90_out>;
			data-lanes = <1 2 3 4>;
		};

		csi_dphy_input4: endpoint@4 {
			reg = <4>;
			remote-endpoint = <&runcam_micro_v3_out>;
			data-lanes = <1 2 3 4>;
		};

		csi_dphy_input5: endpoint@5 {
			reg = <4>;
			remote-endpoint = <&arducam_out>;
			data-lanes = <1 2 3 4>;
		};
	};

	port@1 {
		reg = <1>;
		#address-cells = <1>;
		#size-cells = <0>;

		csidphy0_out: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&mipi0_csi2_input>;
		};
	};
};

&i2c5 {
	status = "okay";
	pinctrl-0 = <&i2c5m2_pins>;

	runcam_micro_v1: runcam-micro-v1@21 {
		compatible = "runcam,micro-v1";
		status = "okay";
		reg = <0x21>;
		clocks = <&cru CLK_MIPI0_OUT2IO>;
		clock-names = "xvclk";
		pinctrl-names = "default";
		pinctrl-0 = <&cam_clk0_pins>;
		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "front";
		rockchip,camera-module-name = "runcam-micro-v1";
		rockchip,camera-module-lens-name = "default";

		port {
			runcam_micro_v1_out: endpoint {
				remote-endpoint = <&csi_dphy_input1>;
				data-lanes = <1 2 3 4>;
			};
		};
	};

	runcam_micro_v2: runcam-micro-v2@22 {
		compatible = "runcam,micro-v2";
		status = "okay";
		reg = <0x22>;
		clocks = <&cru CLK_MIPI0_OUT2IO>;
		clock-names = "xvclk";
		pinctrl-names = "default";
		pinctrl-0 = <&cam_clk0_pins>;
		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "front";
		rockchip,camera-module-name = "runcam-micro-v2";
		rockchip,camera-module-lens-name = "default";

		port {
			runcam_micro_v2_out: endpoint {
				remote-endpoint = <&csi_dphy_input2>;
				data-lanes = <1 2 3 4>;
			};
		};
	};

	runcam_nano_90: runcam-nano-90@23 {
		compatible = "runcam,nano-90";
		status = "okay";
		reg = <0x23>;
		clocks = <&cru CLK_MIPI0_OUT2IO>;
		clock-names = "xvclk";
		pinctrl-names = "default";
		pinctrl-0 = <&cam_clk0_pins>;
		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "front";
		rockchip,camera-module-name = "runcam-nano-90";
		rockchip,camera-module-lens-name = "default";

		port {
			runcam_nano_90_out: endpoint {
				remote-endpoint = <&csi_dphy_input3>;
				data-lanes = <1 2 3 4>;
			};
		};
	};

	runcam_micro_v3: runcam-micro-v3@24 {
		compatible = "runcam,micro-v3";
		status = "okay";
		reg = <0x24>;
		clocks = <&cru CLK_MIPI0_OUT2IO>;
		clock-names = "xvclk";
		pinctrl-names = "default";
		pinctrl-0 = <&cam_clk0_pins>;
		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "front";
		rockchip,camera-module-name = "runcam-micro-v3";
		rockchip,camera-module-lens-name = "default";

		port {
			runcam_micro_v3_out: endpoint {
				remote-endpoint = <&csi_dphy_input4>;
				data-lanes = <1 2 3 4>;
			};
		};
	};

	arducam_pivariety: arducam-pivariety@c {
		status = "okay";
		compatible = "arducam,arducam-pivariety";
		reg = <0x0c>;
		clocks = <&cru CLK_MIPI0_OUT2IO>;
		clock-names = "xclk";
		pinctrl-names = "default";
		pinctrl-0 = <&cam_clk0_pins>;
		rockchip,camera-module-index = <1>;
		rockchip,camera-module-facing = "front";
		rockchip,camera-module-name = "arducam-pivariety";
		rockchip,camera-module-lens-name = "default";
		port {
			arducam_out: endpoint {
				remote-endpoint = <&csi_dphy_input5>;
				data-lanes = <1 2 3 4>;
			};
		};
	};
};

&mipi0_csi2 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi0_csi2_input: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&csidphy0_out>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi0_csi2_output: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&cif_mipi_in0>;
			};
		};
	};
};

&rkcif {
	status = "okay";
};

&rkcif_mipi_lvds {
	status = "okay";

	port {
		cif_mipi_in0: endpoint {
			remote-endpoint = <&mipi0_csi2_output>;
		};
	};
};

&rkcif_mipi_lvds_sditf {
	status = "okay";

	port {
		mipi_lvds_sditf: endpoint {
			remote-endpoint = <&isp_vir0>;
		};
	};
};

&rkcif_mmu {
	status = "okay";
};

&rkisp {
	status = "okay";
};

&rkisp_mmu {
	status = "okay";
};

&rkisp_vir0 {
	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		isp_vir0: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&mipi_lvds_sditf>;
		};
	};
};

&fiq_debugger {
	status = "okay";
};

&fspi0 {
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <75000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;
	};
};

&mpp_srv {
	status = "okay";
};

&mpp_vcodec {
	status = "okay";
};

&rkdvbm {
	status = "okay";
};

&rkvenc {
	venc-supply = <&vdd_npu>;
	status = "okay";
};

&rkvenc_mmu {
	status = "okay";
};

&rkvpss {
	status = "okay";
	dvbm = <&rkdvbm>;
};

&rkvpss_mmu {
	status = "okay";
};

&rng {
	status = "okay";
};

&sdmmc0 {
	max-frequency = <200000000>;
	no-sdio;
	no-mmc;
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	sd-uhs-sdr104;
	vmmc-supply = <&vcc3v3_sd>;
	vqmmc-supply = <&vccio_sd>;
	status = "okay";
};

&saradc0 {
	status = "okay";
};

&tsadc {
	status = "okay";
};

&usb2phy {
	status = "okay";
};

&usb2phy_host {
	phy-supply = <&vcc5v0_sys>;
	status = "okay";
};

&usb2phy_otg {
	status = "okay";
};

&usb_drd_dwc3 {
	status = "okay";
	dr_mode = "peripheral";
};

&usb_host_ehci {
	status = "okay";
};

&usb_host_ohci {
	status = "okay";
};

&vop {
	status = "okay";
};

&vop_mmu {
	status = "okay";
};

// LED MCU UART
&uart3 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart3m2_xfer_pins>;
	status = "okay";
};
